"""Repository rule fetching a pinned static qemu-aarch64 for emulated tests.

`--config=linux-arm64-qemu` runs every aarch64 test binary through this
emulator via `--run_under` (see .bazelrc) instead of whatever qemu-aarch64 the
runner's kernel binfmt_misc handler happens to point at. aarch64 children a
test spawns (re-execs of itself, helper binaries) are still emulated by that
binfmt handler.

Why pinned: QEMU from 7b7a3366e142 (8.1) until bbd5630a75 ("linux-user:
Emulate /proc/self/maps under mmap_lock", 9.2.0, stable 8.2.8), including
Ubuntu noble's qemu-user-static 1:8.2.2+ds-0ubuntu1.18, builds the emulated
/proc/self/maps from a host-maps snapshot taken outside mmap_lock. When one
guest thread reads /proc/self/maps while another maps or unmaps memory,
open_self_maps_2() finds a guest region with no host interval, dereferences
the NULL IntervalTreeNode's `last` field (offset 0x20) and the emulator dies
with "QEMU internal SIGSEGV {code=MAPERR, addr=0x20}". Rust's std backtrace
symbolization reads /proc/self/maps, so a multi-threaded libtest binary that
formats a backtrace hits it nondeterministically.

The emulator comes from Debian trixie's qemu-user package, whose binaries are
static-pie, so it needs no host libraries. The .deb is pinned by SHA-256 and
lands in Bazel's repository cache; snapshot.debian.org keeps the exact file
after the trixie pool moves on.
"""

_QEMU_VERSION = "10.0.13+ds-0+deb13u1"
_QEMU_DEB = "qemu-user_10.0.13%2Bds-0%2Bdeb13u1_amd64.deb"
_QEMU_DEB_SHA256 = "ca6ede739327a20ae5a3498230c8a3a9a072c586e131bc6bcc1201eb1725e336"
_QEMU_DEB_URLS = [
    "https://snapshot.debian.org/archive/debian/20260905T205002Z/pool/main/q/qemu/" + _QEMU_DEB,
    "https://deb.debian.org/debian/pool/main/q/qemu/" + _QEMU_DEB,
]

_BUILD = """\
# Generated by //bazel/toolchains/qemu:qemu_user.bzl — static qemu-aarch64
# from Debian qemu-user {version} (linux-x64 exec host).

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

native_binary(
    name = "qemu-aarch64",
    src = "bin/qemu-aarch64",
    out = "qemu-aarch64",
    visibility = ["//visibility:public"],
)
"""

def _qemu_user_aarch64_impl(rctx):
    if not rctx.os.name.lower().startswith("linux") or rctx.os.arch.lower() not in ("amd64", "x86_64"):
        fail("bazel/toolchains/qemu: the pinned qemu-aarch64 runs only on linux-x64 exec hosts, not {} {}".format(rctx.os.name, rctx.os.arch))
    rctx.report_progress("Downloading Debian qemu-user {} (~68 MiB, repository-cache backed)".format(_QEMU_VERSION))
    rctx.download_and_extract(
        url = _QEMU_DEB_URLS,
        sha256 = _QEMU_DEB_SHA256,
        type = "deb",
        output = "_deb",
    )
    rctx.extract("_deb/data.tar.xz", output = "_deb/data")

    # Keep only the aarch64 emulator; the package carries every qemu-user target.
    rctx.rename("_deb/data/usr/bin/qemu-aarch64", "bin/qemu-aarch64")
    rctx.delete("_deb")
    rctx.file("BUILD.bazel", _BUILD.format(version = _QEMU_VERSION), executable = False)
    return rctx.repo_metadata(reproducible = True)

qemu_user_aarch64_repository = repository_rule(
    implementation = _qemu_user_aarch64_impl,
    doc = "Pinned static qemu-aarch64 (Debian qemu-user) for --config=linux-arm64-qemu tests.",
)
