# syntax=docker/dockerfile:1.7-labs
###############################################################################
# robochud — GitHub triage+fix bot orchestrator.
#
# Extends `chud-base` (from /Dockerfile, default target chudware/chudcode:dev) and adds
# the robochud Python package + a Vite-built SolidJS dashboard bundle. The chud
# toolchain (python + bun + rustup launcher + chud-natives + chudcode_rpc wheel +
# /usr/local/bin/chudcode shim) all comes from CHUDCODE_BASE; this file only layers what's
# robochud-specific.
#
# Build (from chud root):
#     bun run chud:image                              # build chudware/chudcode:dev first
#     docker build -f Dockerfile.robochud -t robochud:dev .
#
# Compose (recommended):
#     docker compose --project-directory python/robochud build
###############################################################################

ARG CHUDCODE_BASE=chudware/chudcode:dev
ARG BUN_VERSION=1.4.0

############################
# 1) web-builder — Bun + Vite, builds the SolidJS dashboard bundle.
############################
FROM oven/bun:${BUN_VERSION}-slim AS web-builder
WORKDIR /work
# Root manifests + the web workspace manifest are enough for `bun install
# --filter robochud-web` to hydrate just the dashboard's node_modules.
COPY package.json bun.lock ./
COPY python/robochud/web/package.json ./python/robochud/web/package.json
# Root package.json declares patchedDependencies, so the patch file must be
# present before any root-level `bun install` (even a filtered one).
COPY patches/*.patch ./patches/
RUN bun install --filter robochud-web
COPY --exclude=node_modules --exclude=dist python/robochud/web/ ./python/robochud/web/
RUN bun --cwd=python/robochud/web run build

############################
# 2) runtime — chud-base + robochud src + web bundle + pip install
############################
FROM ${CHUDCODE_BASE} AS runtime

# robochud runs against the host chud checkout mounted at /work/pi read-only.
ENV CHUDCODE_ROOT=/work/pi

WORKDIR /app

# robochud is an MIT product; Chudcode's dual-license payload remains available from
# the inherited base image under /usr/share/doc/chudcode.
COPY LICENSE THIRD-PARTY-NOTICES.txt /usr/share/doc/robochud/

# robochud itself. Drop the Vite-built dashboard into the package tree before
# `pip install` so it lands in the installed wheel (`static/**/*` is declared
# as package-data in pyproject.toml).
COPY python/robochud/pyproject.toml ./
COPY python/robochud/src/ ./src/
COPY --from=web-builder /work/python/robochud/web/dist/ ./src/static/

RUN pip install --no-cache-dir \
        "fastapi>=0.112" "uvicorn[standard]>=0.30" "httpx>=0.27" \
        "pydantic>=2.6" "pydantic-settings>=2.2" "python-dotenv>=1.0" \
        "click>=8.1" \
    && pip install --no-cache-dir --no-deps .

# Host agent config is mounted read-only under /srv/agent-home-stage with
# host-controlled permissions. The entrypoint copies it into root-owned
# world-readable files under /srv/agent-home; the agent subprocess runs with
# HOME=/srv/agent-home, so ~/.chudcode and ~/.agent resolve there without exposing
# mutable host mounts.
RUN mkdir -p /srv/agent-home/.agent /srv/agent-home/.chudcode/agent \
    && mkdir -p /srv/agent-home-stage/.agent /srv/agent-home-stage/.chudcode/agent \
    && printf '[install]\nbackend = "copyfile"\n' > /srv/agent-home/.bunfig.toml

COPY python/robochud/entrypoint.sh /usr/local/bin/robochud-entrypoint
RUN chmod +x /usr/local/bin/robochud-entrypoint

VOLUME ["/data"]
EXPOSE 8080
EXPOSE 8081

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/robochud-entrypoint"]
CMD ["python", "-m", "robochud", "serve"]
