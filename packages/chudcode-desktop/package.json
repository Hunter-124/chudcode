{
  "name": "@oh-my-pi/chudcode-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/web/index.html --outdir=dist/web --target=browser --minify && bun build ./src/launch.ts --outdir=dist/server --target=bun --external=omp-legacy-pi-modules --external=fastembed --external=onnxruntime-node && mkdir -p dist/native && cp ../natives/native/pi_natives.*.node dist/native/",
    "dev": "bun --watch src/launch.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@oh-my-pi/collab-web": "workspace:*",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-natives": "catalog:",
    "@oh-my-pi/pi-wire": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "d3": "catalog:",
    "lucide-react": "catalog:",
    "monaco-editor": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/d3": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
