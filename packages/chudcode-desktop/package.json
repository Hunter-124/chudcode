{
  "name": "@oh-my-pi/chudcode-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/web/index.html --outdir=dist/web --target=browser --minify && bun build ./src/server.ts --outdir=dist/server --target=bun",
    "dev": "bun --watch src/server.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-natives": "catalog:",
    "@oh-my-pi/pi-wire": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
