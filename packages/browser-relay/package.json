{
	"type": "module",
	"name": "@chudware/browser-relay",
	"version": "0.1.0",
	"private": true,
	"description": "Chrome extension that lets the chudcode browser tool drive your existing tabs (relay server lives in the chudcode CLI: `chudcode browser-relay`)",
	"homepage": "https://chudware.sh",
	"author": "Chudware",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hunter-124/chudcode.git",
		"directory": "packages/browser-relay"
	},
	"scripts": {
		"build": "bun scripts/build-extension.ts",
		"check": "biome check . && tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"puppeteer-core": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
